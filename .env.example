# Copier en .env.local pour brancher la vraie base en local.
# Sans ces deux valeurs, le site tourne en mode démo (stock gardé dans le navigateur).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paiements réels (Stripe + PayPal) via les fonctions Supabase : mettre 1 une fois
# les fonctions déployées et les clés Stripe / PayPal enregistrées (voir README).
# Sinon le paiement reste simulé.
NEXT_PUBLIC_PAYMENTS_ENABLED=
